{
  "name": "nexguard-piec2",
  "version": "1.0.0",
  "private": true,
  "description": "Integração do frontend, backend e telemetria do projeto NexGuard.",
  "scripts": {
    "dev": "npm --prefix Frontend run dev --",
    "build": "npm --prefix Frontend run build",
    "lint": "npm --prefix Frontend run lint",
    "preview": "npm --prefix Frontend run preview --",
    "dev:backend": "python -m uvicorn app.main:app --app-dir Backend --reload --host 127.0.0.1 --port 8000",
    "test:backend": "python -m unittest discover -s Backend/tests -v",
    "start:iot": "node server.js",
    "check": "npm run lint && npm run build && npm run test:backend"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.4"
  }
}
